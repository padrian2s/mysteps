          <Outline color="#ffffffff" width="2">
            <Template>%s:%s
              <Parameter expression="[IS_24_HOUR_MODE] ? [HOUR_0_23_Z] : [HOUR_1_12]" />
              <Parameter expression="[MINUTE_Z]" />
            </Template>
          </Outline>
        </Font>
      </Text>
    </PartText>

    <!-- Divider -->
    <PartDraw x="0" y="322" width="452" height="2" name="Divider">
      <Variant mode="AMBIENT" target="alpha" value="70" />
      <Rectangle x="0" y="0" width="452" height="2">
        <Fill color="#ff3a3a3a" />
      </Rectangle>
    </PartDraw>

    <!-- Date row: [day badge] DAYNAME MON, centered from the measured widths -->
    <Group x="0" y="336" width="400" height="34" name="DateRow">
      <Transform target="x" value="(452 - (58 + ([DAY_OF_WEEK] == 1 ? 110 : ([DAY_OF_WEEK] == 2 ? 118 : ([DAY_OF_WEEK] == 3 ? 122 : ([DAY_OF_WEEK] == 4 ? 168 : ([DAY_OF_WEEK] == 5 ? 142 : ([DAY_OF_WEEK] == 6 ? 93 : 142)))))) + 12 + ([MONTH] == 1 ? 53 : ([MONTH] == 2 ? 48 : ([MONTH] == 3 ? 58 : ([MONTH] == 4 ? 52 : ([MONTH] == 5 ? 59 : ([MONTH] == 6 ? 54 : ([MONTH] == 7 ? 49 : ([MONTH] == 8 ? 56 : ([MONTH] == 9 ? 50 : ([MONTH] == 10 ? 56 : ([MONTH] == 11 ? 58 : 54))))))))))))) / 2" />
      <PartDraw x="0" y="0" width="34" height="34">
        <Variant mode="AMBIENT" target="alpha" value="0" />
        <Ellipse x="0" y="0" width="34" height="34">
          <Fill color="#ff0039a6" />
        </Ellipse>
      </PartDraw>
      <PartDraw x="0" y="0" width="34" height="34" alpha="0">
        <Variant mode="AMBIENT" target="alpha" value="255" />
        <Ellipse x="1.5" y="1.5" width="31" height="31">
          <Stroke color="#ff1a3370" thickness="3" />
        </Ellipse>
      </PartDraw>
      <PartText x="0" y="0" width="34" height="34">
        <Variant mode="AMBIENT" target="alpha" value="150" />
        <Text align="CENTER">
          <Font family="inter_bold" size="18" color="#ffffffff">
            <Template>%s<Parameter expression="[DAY]" /></Template>
          </Font>
        </Text>
      </PartText>
      <PartText x="46" y="0" width="180" height="34">
        <Variant mode="AMBIENT" target="alpha" value="150" />
        <Text align="START">
          <Font family="inter_bold" size="26" letterSpacing="-0.019" color="#ffffffff">
            <Template>%s<Parameter expression="([DAY_OF_WEEK] == 1 ? &quot;SUNDAY&quot; : ([DAY_OF_WEEK] == 2 ? &quot;MONDAY&quot; : ([DAY_OF_WEEK] == 3 ? &quot;TUESDAY&quot; : ([DAY_OF_WEEK] == 4 ? &quot;WEDNESDAY&quot; : ([DAY_OF_WEEK] == 5 ? &quot;THURSDAY&quot; : ([DAY_OF_WEEK] == 6 ? &quot;FRIDAY&quot; : &quot;SATURDAY&quot;))))))" /></Template>
          </Font>
        </Text>
      </PartText>
      <PartText x="160" y="0" width="80" height="34">
        <Transform target="x" value="58 + ([DAY_OF_WEEK] == 1 ? 110 : ([DAY_OF_WEEK] == 2 ? 118 : ([DAY_OF_WEEK] == 3 ? 122 : ([DAY_OF_WEEK] == 4 ? 168 : ([DAY_OF_WEEK] == 5 ? 142 : ([DAY_OF_WEEK] == 6 ? 93 : 142))))))" />
        <Variant mode="AMBIENT" target="alpha" value="150" />
        <Text align="START">
          <Font family="inter_regular" size="26" color="#ffa7a9ac">
            <Template>%s<Parameter expression="([MONTH] == 1 ? &quot;JAN&quot; : ([MONTH] == 2 ? &quot;FEB&quot; : ([MONTH] == 3 ? &quot;MAR&quot; : ([MONTH] == 4 ? &quot;APR&quot; : ([MONTH] == 5 ? &quot;MAY&quot; : ([MONTH] == 6 ? &quot;JUN&quot; : ([MONTH] == 7 ? &quot;JUL&quot; : ([MONTH] == 8 ? &quot;AUG&quot; : ([MONTH] == 9 ? &quot;SEP&quot; : ([MONTH] == 10 ? &quot;OCT&quot; : ([MONTH] == 11 ? &quot;NOV&quot; : &quot;DEC&quot;)))))))))))" /></Template>
          </Font>
        </Text>
      </PartText>
    </Group>

    <!-- Direction line (hidden in always-on): morning goes uptown, evening downtown -->
    <PartText x="0" y="384" width="452" height="18" name="Direction">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="CENTER">
        <Font family="inter_bold" size="12" letterSpacing="0.167" color="#ffa7a9ac">
          <Template>%s<Parameter expression="[HOUR_0_23] &lt; 12 ? &quot;UPTOWN ↑ MORNING&quot; : &quot;DOWNTOWN ↓ EVENING&quot;" /></Template>
        </Font>
      </Text>
    </PartText>

    <!-- Dims the interactive face by 70% (fewer lit OLED subpixels); not in always-on -->
    <PartDraw x="0" y="0" width="452" height="452" name="InteractiveDim" alpha="178">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Rectangle x="0" y="0" width="452" height="452">
        <Fill color="#ff000000" />
      </Rectangle>
    </PartDraw>
  </Scene>
</WatchFace>
